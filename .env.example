# ==========================================================
# بسطة — نموذج المتغيّرات. انسخه إلى .env ولا تلتزم .env أبداً
# ==========================================================

NODE_ENV=development
TZ=UTC                        # ADR-001: كل وقت بالـ UTC حصراً

# --- قاعدة البيانات ---
DATABASE_URL=postgresql://basta:basta_dev_pw@localhost:5432/basta?schema=public
# مستخدم منفصل بصلاحيات INSERT/SELECT فقط على دفتر الأستاذ — ADR-005
DATABASE_LEDGER_URL=postgresql://basta_ledger:ledger_dev_pw@localhost:5432/basta?schema=public

# --- Redis والطوابير ---
REDIS_URL=redis://localhost:6379

# --- البحث ---
MEILI_HOST=http://localhost:7700
MEILI_MASTER_KEY=meili_dev_master_key_change_me

# --- الهوية (ADR-010) ---
JWT_ACCESS_SECRET=change_me_min_32_chars_in_production_
JWT_REFRESH_SECRET=change_me_min_32_chars_in_production_2
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# --- التخزين ---
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=basta-dev
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=auto

# --- الدفع (ADR-012) ---
# fake = المزوّد الوهمي. مخرَج دائم لا سقالة — تُبنى عليه اختبارات المرحلة 08 وتبقى
PAYMENT_PROVIDER=fake
PAYMENT_WEBHOOK_SECRET=fake_webhook_secret

# --- قواعد الأعمال (تعكس settings في قاعدة البيانات) ---
BASE_CURRENCY=USD             # ADR-013
HOLD_PERIOD_DAYS=14           # ADR-007
RESERVATION_TTL_MINUTES=15    # ADR-006
VENDOR_ACCEPT_TIMEOUT_HOURS=48
DEFAULT_COMMISSION_BPS=1000   # 10%
FX_SPREAD_BPS=200             # 2%

# --- المراقبة ---
SENTRY_DSN=
LOG_LEVEL=debug

# --- الواجهة ---
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
