# ==========================================================
# بسطة — نموذج المتغيّرات. انسخه إلى .env ولا تلتزم .env أبداً
# ==========================================================

NODE_ENV=development
TZ=UTC                        # ADR-001: كل وقت بالـ UTC حصراً

# --- قاعدة البيانات ---
# التطبيق يتصل بمستخدم تشغيل لا يملك الجداول، ولا UPDATE/DELETE له على جداول
# الإضافة فقط (ADR-005). ينشئه `npm run db:app-role` بكلمة المرور المكتوبة هنا —
# ولّد كلمة مرور خاصة بك (16 محرفاً على الأقل)، ولا تُعِد استعمال هذا المثال
DATABASE_URL=postgresql://basta_app:CHANGE_ME_generate_a_long_random_one@localhost:5432/basta?schema=public
# المهاجرات وحدها: مالك المخطط. لا يُعطى للتطبيق — ويرفض الإنتاج الإقلاع إن اتصل به
# كلمة مروره هي POSTGRES_PASSWORD أدناه
DATABASE_MIGRATE_URL=postgresql://basta:CHANGE_ME_postgres_password@localhost:5432/basta?schema=public
#
# على Supabase: مجمّع الجلسات (Session pooler، المنفذ 5432) للاثنين — الاتصال المباشر
# IPv6 وحده، ومنفذ المعاملات 6543 يكسر الأقفال الاستشارية والمعاملات الطويلة.
# المستخدم بصيغة «الدور.مرجع_المشروع»، و db:app-role يقرأ الدور مما قبل النقطة:
#   DATABASE_URL=postgresql://basta_app.<ref>:<pass>@aws-0-<region>.pooler.supabase.com:5432/postgres?schema=public&sslmode=require
#   DATABASE_MIGRATE_URL=postgresql://postgres.<ref>:<pass>@aws-0-<region>.pooler.supabase.com:5432/postgres?schema=public&sslmode=require

# --- Redis والطوابير ---
REDIS_URL=redis://:CHANGE_ME_redis_password@localhost:6379

# --- docker compose ---
# كلمات مرور الخدمات المحلية — الملف لا يحملها، وغيابها يوقف `npm run up` برسالته.
# ولّد كلاً منها: openssl rand -base64 24. والمنافذ على 127.0.0.1 وحده
POSTGRES_PASSWORD=CHANGE_ME_postgres_password
REDIS_PASSWORD=CHANGE_ME_redis_password
MINIO_ROOT_USER=basta
MINIO_ROOT_PASSWORD=CHANGE_ME_minio_password

# --- البحث ---
MEILI_HOST=http://localhost:7700
MEILI_MASTER_KEY=CHANGE_ME_meili_master_key

# --- الهوية (ADR-010) ---
JWT_ACCESS_SECRET=change_me_min_32_chars_in_production_
JWT_REFRESH_SECRET=change_me_min_32_chars_in_production_2
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# --- التخزين ---
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=basta-dev
S3_ACCESS_KEY=basta
# هو MINIO_ROOT_PASSWORD أعلاه في التطوير
S3_SECRET_KEY=CHANGE_ME_minio_password
S3_REGION=auto

# --- الدفع (ADR-012) ---
# fake = المزوّد الوهمي. مخرَج دائم لا سقالة — تُبنى عليه اختبارات المرحلة 08 وتبقى
# ممنوع في الإنتاج: الخادم يرفض الإقلاع به، ويرفض سرّ إشعارات أقصر من 32 محرفاً
PAYMENT_PROVIDER=fake
PAYMENT_WEBHOOK_SECRET=fake_webhook_secret

# مفتاح تشفير أسرار التحقق الثنائي — 32 بايتاً base64: openssl rand -base64 32
# إلزامي في الإنتاج. يُحفظ خارج القاعدة ونسخها: ضياعه يُسقط تحقق كل من فعّله (يُعاد
# تفعيله)، وتسرّبه مع القاعدة يعيد المشكلة. التطوير بلا قيمة يشتقّه من JWT_ACCESS_SECRET
TOTP_ENCRYPTION_KEY=

# fake = شركة الشحن الوهمية: تتقدّم كل شحنة حتى «سُلّم» خلال نحو أربعين دقيقة.
# ممنوعة في الإنتاج — التسليم يحرّر مال البائع، والخادم يرفض الإقلاع بها
SHIPPING_CARRIER=fake

# --- قواعد الأعمال (تعكس settings في قاعدة البيانات) ---
BASE_CURRENCY=USD             # ADR-013
HOLD_PERIOD_DAYS=14           # ADR-007
RESERVATION_TTL_MINUTES=15    # ADR-006
VENDOR_ACCEPT_TIMEOUT_HOURS=48
DEFAULT_COMMISSION_BPS=1000   # 10%
FX_SPREAD_BPS=200             # 2%

# --- المراقبة ---
SENTRY_DSN=
LOG_LEVEL=debug

# --- الواجهة ---
# 127.0.0.1 لا localhost: المتصفّح على ويندوز يجرّب ::1 أولاً والخادم يسمع على IPv4
# عنوان الـ API الحقيقي: منه تُصيَّر الصفحات على الخادم وتُحمَّل الصور. المتصفّح لا
# يطلبه مباشرةً — يطلب /api/v1 من نطاق الواجهة وخادمها يمرّره (app/api/v1/[...path])،
# لأن كوكي الجلسة SameSite=Strict لا يعبر بين نطاقين (pages.dev و onrender.com مثلاً)
NEXT_PUBLIC_API_URL=http://127.0.0.1:4000/api/v1
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# محرّك البحث — ADR-014. يعمل بلا تثبيت: npm run search:start
MEILI_URL=http://127.0.0.1:7701
MEILI_KEY=basta_local_dev_key_0001
MEILI_INDEX=products

# --- المرحلة 12: التصليب ------------------------------------------------------
# مصادر إضافية مسموحة لـ CORS (مفصولة بفاصلة). في الإنتاج: NEXT_PUBLIC_SITE_URL وحده ما لم يُضف هنا
CORS_ORIGINS=
# توثيق الـ API مغلق في الإنتاج — true لفتحه صراحةً
API_DOCS=false
# حدود المعدّل: عام لكل عنوان في الدقيقة، وتخمين على الدخول في 15 دقيقة (SRS C-01)
THROTTLE_DEFAULT_LIMIT=600
THROTTLE_AUTH_LIMIT=10
# الوسطاء الموثوقون في X-Forwarded-For — منهم وحدهم يُحسب عنوان الزائر لحدّ المعدّل والتدقيق.
# فارغ = لا يُصدَّق أحد (خادم مكشوف مباشرةً). خلف وسيط عكسي: عددهم (1) أو عناوينهم/نطاقاتهم
# (10.0.0.0/8,127.0.0.1). بغيره يصير كل الزوار عنوان الوسيط، وسكربت واحد يقفل الدخول عن الموقع.
# true مرفوضة: تصدّق الترويسة من أي أحد فيكتب المهاجم العنوان الذي يشاء
TRUST_PROXY=
# سرّ مشترك بين خادم الواجهة والـ API (القيمة نفسها في الاثنين، 32 محرفاً فأكثر في الإنتاج).
# كل طلب من المتصفّح يصل الـ API من خادم الواجهة؛ بهذا السرّ يُرسل معه عنوان الزائر ويُصدَّق.
# فارغ = يُحسب الزوار كلهم عنوان خادم الواجهة — عشر محاولات خاطئة من أي أحد تقفل الدخول عن الموقع.
# إلزامي عملياً في الإنتاج: openssl rand -base64 48
EDGE_PROXY_SECRET=
# صندوق الإشعارات المحلي (نسبة إلى apps/api) ومرسِل البريد
OUTBOX_DIR=outbox
MAIL_FROM="Basta <no-reply@basta.local>"
# البريد الحقيقي عبر SMTP — فارغ = يُكتب البريد ملفات في الصندوق المحلي (التطوير).
# في الإنتاج بدونه لا يصل رمز استعادة كلمة المرور ولا تأكيد البريد أحداً.
# لا يلزمه دومين: مُرسِل واحد موثَّق عند المزوّد، و MAIL_FROM يكون هو نفسه.
#   Brevo (مجاني ~300 رسالة يومياً):  smtp://<login>:<smtp-key>@smtp-relay.brevo.com:587
#   Gmail بكلمة مرور تطبيق:           smtps://you%40gmail.com:<app-password>@smtp.gmail.com:465
# @ و : داخل المستخدم أو كلمة المرور تُرمَّز %40 و %3A
SMTP_URL=
