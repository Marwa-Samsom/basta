{
  "name": "@basta/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "dotenv -e ../../.env -- next dev -p 3000",
    "build": "dotenv -e ../../.env -v NODE_ENV=production -- next build",
    "start": "dotenv -e ../../.env -v NODE_ENV=production -- next start -p 3000",
    "lint": "eslint src --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test:e2e": "dotenv -e ../../.env -- playwright test --config playwright.config.ts",
    "build:probe": "dotenv -e ../../.env -v NODE_ENV=production -v NEXT_DIST_DIR=.next-prod -- next build",
    "serve:probe": "dotenv -e ../../.env -v NODE_ENV=production -v NEXT_DIST_DIR=.next-prod -- next start -p 3100"
  },
  "dependencies": {
    "@sentry/nextjs": "^10.74.0",
    "@tanstack/react-query": "^5.62.11",
    "next": "^16.3.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "eslint-config-next": "^16.3.5",
    "typescript": "^5.7.2",
    "dotenv-cli": "^7.4.4"
  }
}
