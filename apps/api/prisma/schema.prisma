// ============================================================================
// بسطة — مخطط قاعدة البيانات
// مترجَم من docs/01-foundation/ERD.md المعتمد في المرحلة 01
//
// قواعد ملزمة يفرضها هذا الملف:
//   ADR-001  كل مبلغ BigInt بأصغر وحدة عملة، والحقل ينتهي بـ MinorUnits
//   ADR-004  لقطة العمولة على سطر الطلب لا تُقرأ من جدول القواعد بعدها
//   ADR-005  LedgerEntry للإضافة فقط — المشغّل في migrations يرفض UPDATE/DELETE
//   ADR-006  StockReservation جدول مستقل، و inventory.reserved إسقاط له
//   ADR-011  قيود فريدة على أحداث البوابة ومفتاح عدم التكرار
//   ADR-013  المحفظة بمفتاح مركّب (vendorId, currency) — لا جمع بين عملتين
// ============================================================================

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// 1 · الهوية والصلاحيات
// ============================================================================

enum UserStatus {
  active
  suspended
  deleted
}

enum Role {
  customer
  vendor_owner
  vendor_staff
  admin
}

model User {
  id              String     @id @default(uuid()) @db.Uuid
  email           String?    @unique
  phone           String?    @unique
  passwordHash    String?
  fullName        String
  locale          String     @default("ar")
  status          UserStatus @default(active)
  emailVerifiedAt DateTime?  @db.Timestamptz
  phoneVerifiedAt DateTime?  @db.Timestamptz

  // 2FA إلزامي على الإدارة ولا يمكن تعطيله — SRS A-07
  totpSecretEnc String?
  totpEnabledAt DateTime? @db.Timestamptz

  lastLoginAt DateTime? @db.Timestamptz
  deletedAt   DateTime? @db.Timestamptz
  createdAt   DateTime  @default(now()) @db.Timestamptz
  updatedAt   DateTime  @updatedAt @db.Timestamptz

  roles         UserRole[]
  permissions   AdminPermission[]
  refreshTokens RefreshToken[]
  addresses     Address[]
  vendors       Vendor[]
  orders        Order[]
  reviews       Review[]
  auditLogs     AuditLog[]

  @@index([status])
  @@map("users")
}

model UserRole {
  userId    String   @db.Uuid
  role      Role
  grantedAt DateTime @default(now()) @db.Timestamptz
  grantedBy String?  @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, role])
  @@map("user_roles")
}

model AdminPermission {
  userId     String   @db.Uuid
  permission String // vendors.approve · payouts.approve · commissions.edit · disputes.resolve · catalog.manage
  grantedBy  String?  @db.Uuid
  grantedAt  DateTime @default(now()) @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, permission])
  @@map("admin_permissions")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  // familyId يكشف إعادة استخدام رمز مسروق: استعمال رمز مُبطَل يُبطل العائلة كلها
  familyId  String    @db.Uuid
  expiresAt DateTime  @db.Timestamptz
  revokedAt DateTime? @db.Timestamptz
  userAgent String?
  ip        String?
  createdAt DateTime  @default(now()) @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

model OtpCode {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String?   @db.Uuid
  channel    String // sms | email
  purpose    String // login | verify | reset
  codeHash   String
  attempts   Int       @default(0)
  expiresAt  DateTime  @db.Timestamptz
  consumedAt DateTime? @db.Timestamptz
  createdAt  DateTime  @default(now()) @db.Timestamptz

  @@index([userId, purpose])
  @@map("otp_codes")
}

/// للإضافة فقط. كل عملية إدارية أو مالية تكتب سطراً هنا.
model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  actorUserId String?  @db.Uuid
  actorRole   Role?
  action      String
  entityType  String
  entityId    String?
  beforeJson  Json?
  afterJson   Json?
  ip          String?
  userAgent   String?
  createdAt   DateTime @default(now()) @db.Timestamptz

  /**
   * Restrict لا SetNull: تصفير الفاعل تعديلٌ على سجل التدقيق، ومشغّل
   * ADR-005 يرفضه — فكان المخطط يَعِد بسلوك ترفضه قاعدة البيانات.
   * النتيجة المقصودة: المستخدم ذو الأثر التدقيقي لا يُحذف نهائياً أبداً.
   * الحذف منطقي بـ deletedAt، وحق المحو يُنفَّذ بتجهيل الحقول الشخصية
   * مع إبقاء المعرّف — فتبقى سلامة التدقيق وتزول البيانات الشخصية معاً.
   */
  actor User? @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([entityType, entityId])
  @@index([actorUserId, createdAt])
  @@map("audit_logs")
}

// ============================================================================
// 2 · العملات وأسعار الصرف — ADR-013
// ============================================================================

/// minorUnitDigits ليس حقلاً تجميلياً: 50000 = 500.00 دولاراً و 50.000 ديناراً.
/// أي كود يضرب في 100 ثابتاً ينتج خطأً بعشرة أضعاف في الدينار.
model Currency {
  code                String  @id @db.Char(3) // ISO 4217
  nameAr              String
  nameEn              String
  symbol              String
  minorUnitDigits     Int // JOD/KWD = 3 · USD/SAR = 2 · JPY = 0
  minPayoutMinorUnits BigInt // Q-05: لكل عملة حدّها، لا رقم مشترك
  isActive            Boolean @default(true)
  isBase              Boolean @default(false)
  sort                Int     @default(0)

  wallets         Wallet[]
  platformEntries PlatformLedgerEntry[]
  ratesAsBase     ExchangeRate[]        @relation("RateBase")
  ratesAsQuote    ExchangeRate[]        @relation("RateQuote")

  @@map("currencies")
}

/// للإضافة فقط. الجدول الوحيد الذي يحمل نوعاً عشرياً — لأنه معامل تحويل لا مبلغ.
/// ناتج الضرب يُقرَّب فوراً إلى عدد صحيح بأصغر وحدة العملة الهدف.
model ExchangeRate {
  id          String   @id @default(uuid()) @db.Uuid
  baseCode    String   @db.Char(3)
  quoteCode   String   @db.Char(3)
  rate        Decimal  @db.Decimal(20, 10)
  source      String
  effectiveAt DateTime @db.Timestamptz
  fetchedAt   DateTime @default(now()) @db.Timestamptz

  base  Currency @relation("RateBase", fields: [baseCode], references: [code])
  quote Currency @relation("RateQuote", fields: [quoteCode], references: [code])

  @@index([baseCode, quoteCode, effectiveAt(sort: Desc)])
  @@map("exchange_rates")
}

// ============================================================================
// 3 · البائعون
// ============================================================================

/// `pending` مسوّدة لم تُرسل بعد، و `in_review` أُرسلت وتنتظر الإدارة.
/// الفصل بينهما وبين `rejected` متعمَّد: ثلاث حالات مختلفة لا تُشتقّ من تواريخ فارغة.
enum VendorStatus {
  pending
  in_review
  approved
  rejected
  suspended
  banned
}

model Vendor {
  id              String       @id @default(uuid()) @db.Uuid
  ownerUserId     String       @db.Uuid
  slug            String       @unique
  nameAr          String
  nameEn          String?
  logoKey         String?
  coverKey        String?
  descriptionAr   String?
  descriptionEn   String?
  status          VendorStatus @default(pending)
  rejectionReason String?

  /// عملة تسعير البائع وتحصيل مستحقاته معاً — ADR-013.
  /// تُختار افتراضياً من البلد عند التسجيل، ويبقى تغييرها ممكناً حتى يثبّتها
  /// البائع في VD-04. بعد التثبيت لا تتغيّر: محفظة جديدة وتسوية قديمة.
  settlementCurrency         String    @db.Char(3)
  settlementCurrencyLockedAt DateTime? @db.Timestamptz
  country                    String    @db.Char(2)

  /// individual | company — يحدّد الوثائق المتوقَّعة في المراجعة
  businessType   String?
  mainCategoryId String? @db.Uuid

  /// لحظة إرسال الطلب للمراجعة. تُمسح عند الرفض فيعود الطلب مسوّدة قابلة للإصلاح.
  submittedAt DateTime? @db.Timestamptz
  rejectedAt  DateTime? @db.Timestamptz
  suspendedAt DateTime? @db.Timestamptz

  shippingPolicyAr String?
  returnPolicyAr   String?
  ratingAvg        Decimal @default(0) @db.Decimal(3, 2)
  ratingCount      Int     @default(0)

  approvedAt DateTime? @db.Timestamptz
  approvedBy String?   @db.Uuid
  createdAt  DateTime  @default(now()) @db.Timestamptz
  updatedAt  DateTime  @updatedAt @db.Timestamptz

  owner           User                @relation(fields: [ownerUserId], references: [id])
  mainCategory    Category?           @relation(fields: [mainCategoryId], references: [id], onDelete: Restrict)
  documents       VendorDocument[]
  bankAccounts    VendorBankAccount[]
  products        Product[]
  shippingZones   ShippingZone[]
  subOrders       SubOrder[]
  wallets         Wallet[]
  ledgerEntries   LedgerEntry[]
  payouts         PayoutRequest[]
  commissionRules CommissionRule[]
  coupons         Coupon[]

  @@index([status])
  @@index([settlementCurrency])
  @@map("vendors")
}

model VendorDocument {
  id           String    @id @default(uuid()) @db.Uuid
  vendorId     String    @db.Uuid
  type         String // commercial_register | national_id | tax_card | bank_proof
  /// مفتاح في مخزن **خاص** لا في uploads العام: هوية شخصية وسجل تجاري لا يُخدمان برابط مكشوف
  fileKey      String
  mimeType     String
  sizeBytes    Int
  originalName String?
  status       String    @default("pending")
  rejectReason String?
  reviewedBy   String?   @db.Uuid
  reviewedAt   DateTime? @db.Timestamptz
  createdAt    DateTime  @default(now()) @db.Timestamptz
  updatedAt    DateTime  @updatedAt @db.Timestamptz

  vendor Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  /// وثيقة واحدة فعّالة لكل نوع: إعادة الرفع تستبدل لا تكدّس نسخاً يختار المراجع بينها
  @@unique([vendorId, type])
  @@index([vendorId])
  @@map("vendor_documents")
}

model VendorBankAccount {
  id         String    @id @default(uuid()) @db.Uuid
  vendorId   String    @db.Uuid
  holderName String
  iban       String
  bankName   String
  swift      String?
  isDefault  Boolean   @default(false)
  verifiedAt DateTime? @db.Timestamptz
  createdAt  DateTime  @default(now()) @db.Timestamptz

  vendor Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([vendorId])
  @@map("vendor_bank_accounts")
}

// ============================================================================
// 4 · الكتالوج
// ============================================================================

model Category {
  id       String  @id @default(uuid()) @db.Uuid
  parentId String? @db.Uuid
  /// مسار مادّي "/3/17/42/" — يجعل "كل منتجات الفرع" استعلاماً واحداً بـ LIKE
  path     String  @unique
  depth    Int     @default(0)
  slug     String  @unique
  nameAr   String
  nameEn   String?
  iconKey  String?
  sort     Int     @default(0)
  isActive Boolean @default(true)

  parent          Category?           @relation("CategoryTree", fields: [parentId], references: [id])
  children        Category[]          @relation("CategoryTree")
  products        Product[]
  attributes      CategoryAttribute[]
  commissionRules CommissionRule[]
  mainForVendors  Vendor[]

  @@index([parentId])
  // فهرس text_pattern_ops في المهاجرة يخدم LIKE على البادئة
  @@map("categories")
}

model Attribute {
  id            String  @id @default(uuid()) @db.Uuid
  code          String  @unique
  nameAr        String
  nameEn        String?
  inputType     String // select | multiselect | number | text | boolean
  unit          String?
  isFilterable  Boolean @default(true)
  isVariantAxis Boolean @default(false)
  sort          Int     @default(0)

  values         AttributeValue[]
  categories     CategoryAttribute[]
  variantOptions VariantOptionValue[]
  productValues  ProductAttributeValue[]

  @@map("attributes")
}

model AttributeValue {
  id          String  @id @default(uuid()) @db.Uuid
  attributeId String  @db.Uuid
  valueAr     String
  valueEn     String?
  hexColor    String?
  sort        Int     @default(0)

  attribute      Attribute               @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  variantOptions VariantOptionValue[]
  productValues  ProductAttributeValue[]

  @@index([attributeId])
  @@map("attribute_values")
}

model CategoryAttribute {
  categoryId  String  @db.Uuid
  attributeId String  @db.Uuid
  isRequired  Boolean @default(false)
  sort        Int     @default(0)

  category  Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  attribute Attribute @relation(fields: [attributeId], references: [id], onDelete: Cascade)

  @@id([categoryId, attributeId])
  @@map("category_attributes")
}

model Brand {
  id      String  @id @default(uuid()) @db.Uuid
  slug    String  @unique
  nameAr  String
  nameEn  String?
  logoKey String?

  products Product[]

  @@map("brands")
}

enum ProductStatus {
  draft
  pending_review
  active
  rejected
  archived
}

/// لا سعر على المنتج. السعر يعيش على المتغيّر حصراً — ومنتج بلا خيارات
/// يحمل متغيّراً افتراضياً واحداً. هذا يلغي فرعين متوازيين في كل كود تسعير.
model Product {
  id            String        @id @default(uuid()) @db.Uuid
  vendorId      String        @db.Uuid
  categoryId    String        @db.Uuid
  brandId       String?       @db.Uuid
  slug          String        @unique
  nameAr        String
  nameEn        String?
  descriptionAr String?
  descriptionEn String?
  status        ProductStatus @default(draft)
  rejectReason  String?
  hasVariants   Boolean       @default(false)
  ratingAvg     Decimal       @default(0) @db.Decimal(3, 2)
  ratingCount   Int           @default(0)
  soldCount     Int           @default(0)
  publishedAt   DateTime?     @db.Timestamptz
  deletedAt     DateTime?     @db.Timestamptz
  createdAt     DateTime      @default(now()) @db.Timestamptz
  updatedAt     DateTime      @updatedAt @db.Timestamptz

  vendor     Vendor                  @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  category   Category                @relation(fields: [categoryId], references: [id])
  brand      Brand?                  @relation(fields: [brandId], references: [id])
  variants   ProductVariant[]
  images     ProductImage[]
  attrValues ProductAttributeValue[]
  reviews    Review[]
  orderItems OrderItem[]

  /// هدف المفتاح الأجنبي المركّب من المتغيّر — يضمن أن متغيّر المنتج لا يحمل بائعاً غير بائعه
  @@unique([id, vendorId])
  @@index([categoryId, status, publishedAt(sort: Desc)])
  @@index([vendorId, status])
  @@map("products")
}

model ProductVariant {
  id                       String    @id @default(uuid()) @db.Uuid
  productId                String    @db.Uuid
  /// منسوخ من المنتج ومقيَّد بمفتاح أجنبي مركّب (productId, vendorId) فلا يمكن أن يخالفه.
  /// به يصير SKU فريداً لكل بائع كما في ERD، لا لكل منتج.
  vendorId                 String    @db.Uuid
  sku                      String
  /// التركيبة: أزواج سمة:قيمة مرتّبة بمعرّف السمة، و "" للمتغيّر الافتراضي.
  /// فهرس فريد جزئي في المهاجرة يرفض تكرارها داخل المنتج — SRS V-02.
  optionsKey               String    @default("")
  priceMinorUnits          BigInt // ADR-001 — بعملة تسوية البائع
  compareAtPriceMinorUnits BigInt?
  barcode                  String?
  weightGrams              Int?
  lengthMm                 Int?
  widthMm                  Int?
  heightMm                 Int?
  isActive                 Boolean   @default(true)
  /// المتغيّر لا يُحذف بل يُؤرشف: حركات مخزونه للإضافة فقط (ADR-005)،
  /// والأرشفة تحرّر SKU والتركيبة لإعادة الاستعمال.
  archivedAt               DateTime? @db.Timestamptz
  createdAt                DateTime  @default(now()) @db.Timestamptz

  product      Product              @relation(fields: [productId, vendorId], references: [id, vendorId], onDelete: Restrict)
  inventory    Inventory?
  optionValues VariantOptionValue[]
  images       ProductImage[]
  cartItems    CartItem[]
  orderItems   OrderItem[]
  movements    InventoryMovement[]
  reservations StockReservation[]

  // فريدان جزئيان في المهاجرة (WHERE "archivedAt" IS NULL):
  //   (vendorId, sku) · (productId, optionsKey)
  @@index([productId])
  @@map("product_variants")
}

model VariantOptionValue {
  variantId        String @db.Uuid
  attributeId      String @db.Uuid
  attributeValueId String @db.Uuid

  variant        ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  attribute      Attribute      @relation(fields: [attributeId], references: [id])
  attributeValue AttributeValue @relation(fields: [attributeValueId], references: [id])

  @@id([variantId, attributeId])
  @@map("variant_option_values")
}

model ProductAttributeValue {
  id               String   @id @default(uuid()) @db.Uuid
  productId        String   @db.Uuid
  attributeId      String   @db.Uuid
  attributeValueId String?  @db.Uuid
  valueTextAr      String?
  valueTextEn      String?
  valueNumber      Decimal? @db.Decimal(16, 4)
  valueBoolean     Boolean?

  product        Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  attribute      Attribute       @relation(fields: [attributeId], references: [id])
  attributeValue AttributeValue? @relation(fields: [attributeValueId], references: [id])

  @@unique([productId, attributeId])
  @@map("product_attribute_values")
}

model ProductImage {
  id        String  @id @default(uuid()) @db.Uuid
  productId String  @db.Uuid
  variantId String? @db.Uuid
  fileKey   String
  altAr     String?
  altEn     String?
  width     Int?
  height    Int?
  sort      Int     @default(0)

  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([productId, sort])
  @@map("product_images")
}

// ============================================================================
// 5 · المخزون والحجوزات — ADR-006
// ============================================================================

/// المتاح = onHand − reserved (محسوب لا مخزَّن).
/// reserved إسقاط لمجموع الحجوزات النشطة — يُدقَّق ليلياً (INV-11).
/// قيود CHECK تُضاف في المهاجرة: onHand >= 0, reserved >= 0, reserved <= onHand
model Inventory {
  variantId         String    @id @db.Uuid
  onHand            Int       @default(0)
  reserved          Int       @default(0)
  lowStockThreshold Int       @default(5)
  backorderAllowed  Boolean   @default(false)
  /// لحظة نزول onHand إلى العتبة أو دونها، وتُمسح عند تجاوزها صعوداً.
  /// وحدة الإشعارات (المرحلة 11) تستهلكها — المخزون يرصد ولا يرسل.
  lowStockSince     DateTime? @db.Timestamptz
  version           Int       @default(0)
  updatedAt         DateTime  @updatedAt @db.Timestamptz

  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@map("inventory")
}

enum ReservationStatus {
  active
  committed
  released
  expired
}

/// السلة لا تحجز. الصف يُنشأ لحظة دخول صفحة الدفع بمهلة 15 دقيقة.
/// مهمة كل دقيقة تنقل active المنتهي إلى expired وتنقص reserved.
model StockReservation {
  id          String            @id @default(uuid()) @db.Uuid
  variantId   String            @db.Uuid
  cartId      String?           @db.Uuid
  orderId     String?           @db.Uuid
  qty         Int
  status      ReservationStatus @default(active)
  expiresAt   DateTime          @db.Timestamptz
  committedAt DateTime?         @db.Timestamptz
  releasedAt  DateTime?         @db.Timestamptz
  createdAt   DateTime          @default(now()) @db.Timestamptz

  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  // فهرس جزئي في المهاجرة: WHERE status = 'active' — يجعل مهمة التحرير رخيصة
  @@index([expiresAt])
  @@index([cartId])
  @@index([orderId])
  @@map("stock_reservations")
}

/// للإضافة فقط. مجموع delta يجب أن يساوي inventory.onHand — ثابت INV-04
model InventoryMovement {
  id          String   @id @default(uuid()) @db.Uuid
  variantId   String   @db.Uuid
  delta       Int
  reason      String // sale | return | cancel | manual_adjust | import | damage
  refType     String?
  refId       String?
  actorUserId String?  @db.Uuid
  note        String?
  createdAt   DateTime @default(now()) @db.Timestamptz

  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@index([variantId, createdAt])
  @@map("inventory_movements")
}

// ============================================================================
// 6 · السلة
// ============================================================================

model Cart {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String?  @db.Uuid
  sessionToken String?  @unique
  /// عملة عرض المشتري — التحويل للعرض فقط (ADR-013)
  currency     String   @db.Char(3)
  couponCode   String?
  expiresAt    DateTime @db.Timestamptz
  createdAt    DateTime @default(now()) @db.Timestamptz
  updatedAt    DateTime @updatedAt @db.Timestamptz

  items CartItem[]

  @@index([userId])
  @@index([expiresAt])
  @@map("carts")
}

model CartItem {
  id                   String   @id @default(uuid()) @db.Uuid
  cartId               String   @db.Uuid
  variantId            String   @db.Uuid
  /// مكرر عمداً لتجميع السلة حسب البائع بلا ربط إضافي
  vendorId             String   @db.Uuid
  qty                  Int
  /// للمقارنة والتنبيه فقط — السعر النافذ هو سعر لحظة الطلب
  priceMinorUnitsAtAdd BigInt
  addedAt              DateTime @default(now()) @db.Timestamptz

  cart    Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id])

  @@unique([cartId, variantId])
  @@index([cartId, vendorId])
  @@map("cart_items")
}

model Address {
  id            String    @id @default(uuid()) @db.Uuid
  userId        String    @db.Uuid
  label         String?
  country       String    @db.Char(2)
  region        String
  city          String
  area          String?
  street        String
  building      String?
  floor         String?
  landmark      String?
  lat           Decimal?  @db.Decimal(10, 7)
  lng           Decimal?  @db.Decimal(10, 7)
  recipientName String
  phone         String
  isDefault     Boolean   @default(false)
  deletedAt     DateTime? @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("addresses")
}

// ============================================================================
// 7 · الطلبات — ADR-003
// ============================================================================

enum OrderStatus {
  pending_payment
  payment_failed
  processing
  partially_completed
  completed
  canceled
  refunded
}

enum SubOrderStatus {
  awaiting_vendor
  accepted
  preparing
  ready_to_ship
  shipped
  delivery_failed
  delivered
  return_requested
  returned
  completed
  rejected_by_vendor
  canceled_by_customer
  canceled_by_admin
  refunded
}

/// الطلب الأب — كيان مالي واحد يقابل عملية دفع واحدة.
/// status مشتقّ من الأبناء ولا يُحدَّث يدوياً أبداً.
model Order {
  id             String  @id @default(uuid()) @db.Uuid
  orderNumber    String  @unique
  customerUserId String? @db.Uuid
  guestEmail     String?
  guestPhone     String?
  /// ADR-011: إعادة الإرسال بالمفتاح نفسه تُرجع الطلب الأصلي لا طلباً ثانياً
  idempotencyKey String  @unique
  /// عملة التحصيل — يُخصم بها المشتري فعلياً (ADR-013)
  currency       String  @db.Char(3)

  itemsSubtotalMinorUnits BigInt
  shippingTotalMinorUnits BigInt @default(0)
  discountTotalMinorUnits BigInt @default(0)
  taxTotalMinorUnits      BigInt @default(0)
  grandTotalMinorUnits    BigInt

  status OrderStatus @default(pending_payment)

  /// لقطة لا مرجع: تعديل المشتري لعنوانه لاحقاً لا يغيّر عنوان طلب سابق
  shippingAddressSnapshot Json
  billingAddressSnapshot  Json?
  customerNote            String?

  /// ADR-003: ما يُقسَّم عند نجاح الدفع — لا السلة، فالسلة قد تتغيّر بعد «ادفع»
  pricingSnapshot Json?
  /// حجوزات المخزون المأخوذة عند بدء الدفع: تُثبَّت عند النجاح وتُحرَّر عند الفشل
  reservationIds  String[]  @default([]) @db.Uuid
  paidAt          DateTime? @db.Timestamptz

  placedAt   DateTime  @default(now()) @db.Timestamptz
  canceledAt DateTime? @db.Timestamptz

  customer    User?              @relation(fields: [customerUserId], references: [id], onDelete: SetNull)
  subOrders   SubOrder[]
  items       OrderItem[]
  payment     Payment?
  redemptions CouponRedemption[]

  @@index([customerUserId, placedAt(sort: Desc)])
  @@index([status])
  @@map("orders")
}

/// وحدة التنفيذ الحقيقية. كل مبالغه بعملة البائع لا بعملة تحصيل المشتري.
model SubOrder {
  id             String @id @default(uuid()) @db.Uuid
  orderId        String @db.Uuid
  vendorId       String @db.Uuid
  subOrderNumber String @unique

  /// ADR-013: عملة البائع، وسعر الصرف ملقوط لحظة الطلب فلا يتغيّر بعده
  settlementCurrency String  @db.Char(3)
  fxRateSnapshot     Decimal @db.Decimal(20, 10)

  itemsSubtotalMinorUnits BigInt
  shippingMinorUnits      BigInt @default(0)
  discountMinorUnits      BigInt @default(0)
  taxMinorUnits           BigInt @default(0)
  totalMinorUnits         BigInt

  /// ADR-004: اللقطة تُقرأ في كل احتساب لاحق، ولا يُستشار جدول القواعد ثانيةً
  commissionRateBpsSnapshot Int
  commissionMinorUnits      BigInt
  /// حصّة هذا الفرعي **بعملة الدفع**. مجموعها = grandTotal الأب بالبناء — بوابة 08
  chargeTotalMinorUnits     BigInt?
  /// = itemsSubtotal − discount − commission + shipping (لا عمولة على الشحن — ADR-008)
  vendorNetMinorUnits       BigInt

  status SubOrderStatus @default(awaiting_vendor)

  placedAt      DateTime  @default(now()) @db.Timestamptz
  acceptedAt    DateTime? @db.Timestamptz
  shippedAt     DateTime? @db.Timestamptz
  deliveredAt   DateTime? @db.Timestamptz
  /// ADR-007: deliveredAt + settings.hold_period_days
  holdReleaseAt DateTime? @db.Timestamptz
  completedAt   DateTime? @db.Timestamptz
  canceledAt    DateTime? @db.Timestamptz
  cancelReason  String?

  order           Order                   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  vendor          Vendor                  @relation(fields: [vendorId], references: [id])
  items           OrderItem[]
  statusHistory   SubOrderStatusHistory[]
  shipment        Shipment?
  returns         ReturnRequest[]
  disputes        Dispute[]
  refunds         Refund[]
  ledgerEntries   LedgerEntry[]
  platformEntries PlatformLedgerEntry[]

  @@index([orderId])
  @@index([vendorId, status, placedAt(sort: Desc)])
  // فهرس جزئي في المهاجرة لمهمة التحرير اليومية
  @@index([holdReleaseAt])
  @@map("sub_orders")
}

/// كل لقطة هنا تضمن أن فاتورة قديمة تُعرض كما كانت، ولو حُذف المنتج أو تغيّر اسمه.
model OrderItem {
  id         String @id @default(uuid()) @db.Uuid
  subOrderId String @db.Uuid
  orderId    String @db.Uuid
  vendorId   String @db.Uuid
  variantId  String @db.Uuid
  productId  String @db.Uuid

  productNameSnapshotAr String
  variantLabelSnapshot  String?
  skuSnapshot           String
  imageKeySnapshot      String?

  unitPriceMinorUnits    BigInt
  qty                    Int
  lineSubtotalMinorUnits BigInt
  lineDiscountMinorUnits BigInt @default(0)
  lineTaxMinorUnits      BigInt @default(0)
  lineTotalMinorUnits    BigInt

  /// ADR-001: floor(lineTotal × bps / 10000) — تقريب لأسفل لصالح البائع
  commissionBpsSnapshot Int
  commissionMinorUnits  BigInt

  refundedQty Int @default(0)

  subOrder SubOrder       @relation(fields: [subOrderId], references: [id], onDelete: Cascade)
  order    Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant  ProductVariant @relation(fields: [variantId], references: [id])
  product  Product        @relation(fields: [productId], references: [id])
  review   Review?

  @@index([subOrderId])
  @@index([orderId])
  @@map("order_items")
}

model SubOrderStatusHistory {
  id          String          @id @default(uuid()) @db.Uuid
  subOrderId  String          @db.Uuid
  fromStatus  SubOrderStatus?
  toStatus    SubOrderStatus
  actorUserId String?         @db.Uuid
  actorRole   Role?
  reason      String?
  createdAt   DateTime        @default(now()) @db.Timestamptz

  subOrder SubOrder @relation(fields: [subOrderId], references: [id], onDelete: Cascade)

  @@index([subOrderId, createdAt])
  @@map("sub_order_status_history")
}

// ============================================================================
// 8 · الشحن — ADR-008 (بمسؤولية البائع)
// ============================================================================

model ShippingZone {
  id       String  @id @default(uuid()) @db.Uuid
  vendorId String  @db.Uuid
  nameAr   String
  isActive Boolean @default(true)

  vendor  Vendor               @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  regions ShippingZoneRegion[]
  rates   ShippingRate[]

  @@index([vendorId])
  @@map("shipping_zones")
}

model ShippingZoneRegion {
  id      String  @id @default(uuid()) @db.Uuid
  zoneId  String  @db.Uuid
  country String  @db.Char(2)
  region  String?
  city    String?

  zone ShippingZone @relation(fields: [zoneId], references: [id], onDelete: Cascade)

  @@index([zoneId])
  @@index([country, region, city])
  @@map("shipping_zone_regions")
}

model ShippingRate {
  id                 String  @id @default(uuid()) @db.Uuid
  zoneId             String  @db.Uuid
  method             String // flat | by_weight | free_over
  priceMinorUnits    BigInt  @default(0)
  perKgMinorUnits    BigInt?
  freeOverMinorUnits BigInt?
  minDays            Int     @default(1)
  maxDays            Int     @default(7)
  isActive           Boolean @default(true)

  zone ShippingZone @relation(fields: [zoneId], references: [id], onDelete: Cascade)

  @@index([zoneId])
  @@map("shipping_rates")
}

model Shipment {
  id             String    @id @default(uuid()) @db.Uuid
  subOrderId     String    @unique @db.Uuid
  carrierCode    String
  trackingNumber String
  labelUrl       String?
  status         String    @default("created")
  shippedAt      DateTime? @db.Timestamptz
  deliveredAt    DateTime? @db.Timestamptz

  subOrder SubOrder        @relation(fields: [subOrderId], references: [id], onDelete: Cascade)
  events   ShipmentEvent[]

  @@map("shipments")
}

model ShipmentEvent {
  id            String   @id @default(uuid()) @db.Uuid
  shipmentId    String   @db.Uuid
  code          String
  descriptionAr String?
  location      String?
  occurredAt    DateTime @db.Timestamptz

  shipment Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@index([shipmentId, occurredAt])
  @@map("shipment_events")
}

// ============================================================================
// 9 · الخصومات والضريبة
// ============================================================================

model Coupon {
  id       String  @id @default(uuid()) @db.Uuid
  code     String  @unique
  scope    String // platform | vendor
  vendorId String? @db.Uuid
  type     String // percent | fixed | free_shipping

  valueBps              Int?
  valueMinorUnits       BigInt?
  maxDiscountMinorUnits BigInt?
  minOrderMinorUnits    BigInt?
  currency              String? @db.Char(3)

  usageLimitTotal   Int?
  usageLimitPerUser Int?
  usedCount         Int  @default(0)

  /// Q-06: الحقل الحاسم — من يتحمّل الخصم في الدفتر.
  /// الافتراضي platform: كوبون تصدره المنصة تتحمّله المنصة.
  fundedBy String @default("platform")

  startsAt DateTime? @db.Timestamptz
  endsAt   DateTime? @db.Timestamptz
  isActive Boolean   @default(true)

  vendor      Vendor?            @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  conditions  CouponCondition[]
  redemptions CouponRedemption[]

  @@index([isActive, startsAt, endsAt])
  @@map("coupons")
}

model CouponCondition {
  id            String  @id @default(uuid()) @db.Uuid
  couponId      String  @db.Uuid
  conditionType String // category | product | vendor | first_order
  refId         String? @db.Uuid

  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)

  @@index([couponId])
  @@map("coupon_conditions")
}

model CouponRedemption {
  id                 String   @id @default(uuid()) @db.Uuid
  couponId           String   @db.Uuid
  orderId            String   @db.Uuid
  userId             String?  @db.Uuid
  discountMinorUnits BigInt
  createdAt          DateTime @default(now()) @db.Timestamptz

  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)
  order  Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([couponId, orderId])
  @@index([couponId, userId])
  @@map("coupon_redemptions")
}

/// ADR-013: الضريبة تتبع بلد المشتري لا عملته، ولكل بلد isPriceInclusive مستقل.
/// لا إعداد ضريبة عام واحد في المنصة (Q-04).
model TaxRate {
  id               String    @id @default(uuid()) @db.Uuid
  country          String    @db.Char(2)
  region           String?
  rateBps          Int
  isPriceInclusive Boolean   @default(true)
  effectiveFrom    DateTime  @db.Timestamptz
  effectiveTo      DateTime? @db.Timestamptz

  @@index([country, region, effectiveFrom])
  @@map("tax_rates")
}

// ============================================================================
// 10 · الدفع — ADR-011, ADR-012
// ============================================================================

enum PaymentStatus {
  pending
  requires_action
  authorized
  captured
  partially_refunded
  refunded
  failed
  voided
}

model Payment {
  id               String        @id @default(uuid()) @db.Uuid
  orderId          String        @unique @db.Uuid
  provider         String
  providerIntentId String?
  amountMinorUnits BigInt
  currency         String        @db.Char(3)
  method           String // card | wallet | cod
  status           PaymentStatus @default(pending)
  authorizedAt     DateTime?     @db.Timestamptz
  capturedAt       DateTime?     @db.Timestamptz
  failureCode      String?
  failureMessage   String?
  createdAt        DateTime      @default(now()) @db.Timestamptz

  order   Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  events  PaymentEvent[]
  refunds Refund[]

  @@index([status, createdAt])
  @@map("payments")
}

/// القيد الفريد على (provider, providerEventId) هو وحده ما يمنع طلباً مكرراً
/// عند وصول إشعار البوابة مرتين — ADR-011.
model PaymentEvent {
  id              String    @id @default(uuid()) @db.Uuid
  paymentId       String?   @db.Uuid
  provider        String
  providerEventId String
  type            String
  payloadJson     Json
  processedAt     DateTime? @db.Timestamptz
  receivedAt      DateTime  @default(now()) @db.Timestamptz

  payment Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@unique([provider, providerEventId])
  @@index([paymentId])
  @@map("payment_events")
}

model Refund {
  id                     String   @id @default(uuid()) @db.Uuid
  subOrderId             String   @db.Uuid
  paymentId              String   @db.Uuid
  amountMinorUnits       BigInt
  reason                 String
  status                 String   @default("pending")
  providerRefundId       String?
  requestedBy            String?  @db.Uuid
  approvedBy             String?  @db.Uuid
  ledgerEntryId          String?  @db.Uuid
  /// قيمة الاسترداد بعملة البائع — ما يقابله في الدفتر (amountMinorUnits بعملة الدفع)
  vendorAmountMinorUnits BigInt?
  createdAt              DateTime @default(now()) @db.Timestamptz

  subOrder SubOrder @relation(fields: [subOrderId], references: [id], onDelete: Cascade)
  payment  Payment  @relation(fields: [paymentId], references: [id])

  @@index([subOrderId])
  @@map("refunds")
}

// ============================================================================
// 11 · المال — ADR-005 · النواة الحرجة
// ============================================================================

/// لا تُحذف قاعدة أبداً — تُنهى صلاحيتها بـ effectiveTo فقط،
/// ليبقى تفسير أي عمولة تاريخية ممكناً.
model CommissionRule {
  id               String    @id @default(uuid()) @db.Uuid
  scope            String // global | category | vendor
  categoryId       String?   @db.Uuid
  vendorId         String?   @db.Uuid
  rateBps          Int
  minFeeMinorUnits BigInt?
  maxFeeMinorUnits BigInt?
  effectiveFrom    DateTime  @db.Timestamptz
  effectiveTo      DateTime? @db.Timestamptz
  createdBy        String?   @db.Uuid
  createdAt        DateTime  @default(now()) @db.Timestamptz

  category Category? @relation(fields: [categoryId], references: [id])
  vendor   Vendor?   @relation(fields: [vendorId], references: [id])

  @@index([scope, effectiveFrom])
  @@index([vendorId])
  @@index([categoryId])
  @@map("commission_rules")
}

/// ADR-013: محفظة لكل عملة. لا يُجمع رصيدان بعملتين في رقم واحد أبداً.
/// الأرصدة إسقاط محسوب لا مصدر حقيقة — تُقفل بـ SELECT ... FOR UPDATE.
model Wallet {
  id       String @id @default(uuid()) @db.Uuid
  vendorId String @db.Uuid
  currency String @db.Char(3)

  balancePendingMinorUnits   BigInt @default(0)
  balanceAvailableMinorUnits BigInt @default(0)
  balanceWithdrawnMinorUnits BigInt @default(0)

  version   Int      @default(0)
  updatedAt DateTime @updatedAt @db.Timestamptz

  vendor  Vendor          @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  curr    Currency        @relation(fields: [currency], references: [code])
  entries LedgerEntry[]
  payouts PayoutRequest[]

  @@unique([vendorId, currency])
  @@map("wallets")
}

enum LedgerEntryType {
  sale_credit
  commission_debit
  shipping_credit
  hold_release_out
  hold_release_in
  refund_debit
  payout_debit
  adjustment_credit
  adjustment_debit
  fx_rounding
}

/// مصدر الحقيقة المالي الوحيد. للإضافة فقط —
/// مشغّل في المهاجرة يرفض UPDATE و DELETE، والصلاحيات تمنح INSERT/SELECT فقط.
/// أي تصحيح قيد جديد معاكس بـ reversesEntryId، لا تعديل.
model LedgerEntry {
  id       String @id @default(uuid()) @db.Uuid
  walletId String @db.Uuid
  vendorId String @db.Uuid
  /// فائض عن walletId عمداً: يجعل أي استعلام تجميعي يفشل صراحةً
  /// إن نسي GROUP BY currency، بدل أن يجمع تفاحاً وبرتقالاً بصمت (INV-12)
  currency String @db.Char(3)

  entryType        LedgerEntryType
  direction        String // credit | debit
  amountMinorUnits BigInt
  bucket           String // pending | available

  refType String?
  refId   String? @db.Uuid

  reversesEntryId String?  @db.Uuid
  memo            String?
  createdBy       String?  @db.Uuid
  createdAt       DateTime @default(now()) @db.Timestamptz

  wallet   Wallet    @relation(fields: [walletId], references: [id])
  vendor   Vendor    @relation(fields: [vendorId], references: [id])
  subOrder SubOrder? @relation(fields: [refId], references: [id], onDelete: NoAction, map: "ledger_suborder_fk")

  @@index([vendorId, currency, createdAt(sort: Desc)])
  @@index([walletId, bucket])
  @@index([refType, refId])
  @@map("ledger_entries")
}

/// نصيب المنصة لكل فرعي — للإضافة فقط كدفتر البائع. مع دفتر البائع والاستردادات
/// يساوي ما دُفع بالقرش: المنظر audit_money_conservation (بوابة 10).
model PlatformLedgerEntry {
  id               String   @id @default(uuid()) @db.Uuid
  subOrderId       String   @db.Uuid
  currency         String   @db.Char(3)
  /// commission · tax_held · discount_subsidy · rounding
  entryType        String
  /// credit = للمنصة، debit = عليها
  direction        String
  amountMinorUnits BigInt
  reversesEntryId  String?  @db.Uuid
  refundId         String?  @db.Uuid
  memo             String?
  createdAt        DateTime @default(now()) @db.Timestamptz

  subOrder SubOrder @relation(fields: [subOrderId], references: [id], onDelete: Restrict, map: "platform_ledger_suborder_fk")
  curr     Currency @relation(fields: [currency], references: [code], map: "platform_ledger_currency_fk")

  @@index([subOrderId])
  @@index([currency, createdAt])
  @@map("platform_ledger_entries")
}

enum PayoutStatus {
  requested
  approved
  processing
  paid
  rejected
}

model PayoutRequest {
  id               String       @id @default(uuid()) @db.Uuid
  vendorId         String       @db.Uuid
  walletId         String       @db.Uuid
  currency         String       @db.Char(3)
  amountMinorUnits BigInt
  status           PayoutStatus @default(requested)

  /// لقطة: تغيير البائع لحسابه لاحقاً لا يغيّر سجل تحويل تمّ فعلاً
  bankAccountSnapshot Json
  ledgerEntryId       String? @db.Uuid

  requestedAt       DateTime  @default(now()) @db.Timestamptz
  approvedBy        String?   @db.Uuid
  approvedAt        DateTime? @db.Timestamptz
  paidAt            DateTime? @db.Timestamptz
  transferReference String?
  rejectReason      String?

  vendor Vendor @relation(fields: [vendorId], references: [id])
  wallet Wallet @relation(fields: [walletId], references: [id])

  @@index([vendorId, status])
  @@index([status, requestedAt])
  @@map("payout_requests")
}

// ============================================================================
// 12 · المراجعات والنزاعات
// ============================================================================

/// القيد الفريد على orderItemId هو ما يجعل كل مراجعة موثّقة بشراء فعلي —
/// لا حقل isVerified يُضبط يدوياً.
model Review {
  id           String   @id @default(uuid()) @db.Uuid
  orderItemId  String   @unique @db.Uuid
  productId    String   @db.Uuid
  vendorId     String   @db.Uuid
  userId       String   @db.Uuid
  rating       Int
  title        String?
  body         String?
  status       String   @default("pending")
  rejectReason String?
  createdAt    DateTime @default(now()) @db.Timestamptz

  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id])

  @@index([productId, status, createdAt(sort: Desc)])
  @@map("reviews")
}

model ReturnRequest {
  id          String    @id @default(uuid()) @db.Uuid
  subOrderId  String    @db.Uuid
  itemsJson   Json
  reasonCode  String
  description String?
  mediaKeys   String[]
  status      String    @default("requested")
  requestedAt DateTime  @default(now()) @db.Timestamptz
  resolvedBy  String?   @db.Uuid
  resolvedAt  DateTime? @db.Timestamptz

  subOrder SubOrder @relation(fields: [subOrderId], references: [id], onDelete: Cascade)

  @@index([subOrderId])
  @@index([status])
  @@map("return_requests")
}

/// نزاع مفتوح يجمّد holdReleaseAt ولو انقضت المدة — ADR-007
model Dispute {
  id             String    @id @default(uuid()) @db.Uuid
  subOrderId     String    @db.Uuid
  openedByUserId String    @db.Uuid
  against        String // vendor | customer
  reasonCode     String
  status         String    @default("open")
  resolution     String?
  resolvedBy     String?   @db.Uuid
  closedAt       DateTime? @db.Timestamptz
  createdAt      DateTime  @default(now()) @db.Timestamptz

  subOrder SubOrder         @relation(fields: [subOrderId], references: [id], onDelete: Cascade)
  messages DisputeMessage[]

  @@index([subOrderId])
  @@index([status])
  @@map("disputes")
}

model DisputeMessage {
  id           String   @id @default(uuid()) @db.Uuid
  disputeId    String   @db.Uuid
  senderUserId String   @db.Uuid
  senderRole   Role
  body         String
  attachments  String[]
  createdAt    DateTime @default(now()) @db.Timestamptz

  dispute Dispute @relation(fields: [disputeId], references: [id], onDelete: Cascade)

  @@index([disputeId, createdAt])
  @@map("dispute_messages")
}

// ============================================================================
// 13 · المنصة
// ============================================================================

model Setting {
  key       String   @id
  valueJson Json
  updatedBy String?  @db.Uuid
  updatedAt DateTime @updatedAt @db.Timestamptz

  @@map("settings")
}

model NotificationTemplate {
  code          String  @db.VarChar(64)
  channel       String // email | sms | whatsapp | push | in_app
  locale        String  @db.Char(2)
  subject       String?
  body          String
  variablesJson Json?
  isEnabled     Boolean   @default(true)
  /// بوابة 11: كل قالب عربي مراجَع لغوياً — ومن راجعه
  reviewedAt    DateTime? @db.Timestamptz
  reviewedBy    String?
  updatedAt     DateTime  @default(now()) @db.Timestamptz
  updatedBy     String?   @db.Uuid

  @@id([code, channel, locale])
  @@map("notification_templates")
}

model Notification {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @db.Uuid
  channel      String
  templateCode String
  payloadJson  Json
  /// queued · sending · sent · failed · skipped — صندوق صادر يُرسل بعد الالتزام
  status       String    @default("queued")
  error        String?
  /// النص كما أُرسل — تعديل القالب لاحقاً لا يغيّره
  recipient    String?
  subject      String?
  body         String?
  attempts     Int       @default(0)
  deliveryRef  String?
  sentAt       DateTime? @db.Timestamptz
  readAt       DateTime? @db.Timestamptz
  createdAt    DateTime  @default(now()) @db.Timestamptz

  @@index([userId, createdAt(sort: Desc)])
  @@index([status])
  @@map("notifications")
}

model PushSubscription {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  endpoint  String   @unique
  keysJson  Json
  userAgent String?
  createdAt DateTime @default(now()) @db.Timestamptz

  @@index([userId])
  @@map("push_subscriptions")
}

model CmsPage {
  id          String   @id @default(uuid()) @db.Uuid
  slug        String   @unique
  titleAr     String
  bodyAr      String
  isPublished Boolean  @default(false)
  updatedAt   DateTime @updatedAt @db.Timestamptz
  updatedBy   String?  @db.Uuid

  @@map("cms_pages")
}

model Banner {
  id        String    @id @default(uuid()) @db.Uuid
  placement String
  imageKey  String
  linkUrl   String?
  titleAr   String?
  sort      Int       @default(0)
  startsAt  DateTime? @db.Timestamptz
  endsAt    DateTime? @db.Timestamptz
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now()) @db.Timestamptz
  updatedBy String?   @db.Uuid

  @@index([placement, isActive])
  @@map("banners")
}
