{
  "name": "@basta/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "dotenv -e ../../.env -- nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "lint": "eslint src --max-warnings 0",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.scripts.json",
    "test": "dotenv -e ../../.env -- vitest run",
    "test:watch": "vitest",
    "db:generate": "dotenv -e ../../.env -- prisma generate",
    "db:migrate": "dotenv -e ../../.env -- prisma migrate dev && npm run db:app-role",
    "db:deploy": "dotenv -e ../../.env -- prisma migrate deploy && npm run db:app-role",
    "db:seed": "npm run db:app-role && dotenv -e ../../.env -- tsx prisma/seed.ts",
    "db:studio": "dotenv -e ../../.env -- prisma studio",
    "db:reset": "dotenv -e ../../.env -- prisma migrate reset --force && npm run db:app-role",
    "admin:grant": "dotenv -e ../../.env -- tsx scripts/grant-admin.ts",
    "totp:seal": "dotenv -e ../../.env -- tsx scripts/seal-totp-secrets.ts",
    "demo:seed": "dotenv -e ../../.env -- tsx scripts/seed-demo.ts",
    "images:backfill": "dotenv -e ../../.env -- tsx scripts/backfill-medium.ts",
    "probe:load": "dotenv -e ../../.env -- tsx scripts/load-probe.ts",
    "db:app-role": "dotenv -e ../../.env -- tsx scripts/db-app-role.ts"
  },
  "prisma": {
    "seed": "npm run db:app-role && dotenv -e ../../.env -- tsx prisma/seed.ts"
  },
  "dependencies": {
    "@fastify/multipart": "^10.1.1",
    "@fastify/static": "^10.1.3",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.1",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/platform-fastify": "^11.0.1",
    "@nestjs/swagger": "^11.0.2",
    "@nestjs/throttler": "^6.5.0",
    "@node-rs/argon2": "^2.2.1",
    "@prisma/client": "^6.2.1",
    "@sentry/nestjs": "^10.74.0",
    "@sentry/profiling-node": "^10.74.0",
    "bullmq": "^5.34.6",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "csv-parse": "^7.0.2",
    "exceljs": "^4.4.0",
    "ioredis": "^5.4.2",
    "meilisearch": "^0.47.0",
    "otplib": "^13.5.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sharp": "^0.35.4",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@swc/core": "^1.16.2",
    "@types/node": "^22.10.5",
    "dotenv-cli": "^11.0.0",
    "prisma": "^6.2.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "unplugin-swc": "^1.6.0",
    "vitest": "^5.0.1"
  }
}
