{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev:api"
      ],
      "port": 4000
    },
    {
      "name": "api-manual",
      "runtimeExecutable": "cmd",
      "runtimeArgs": [
        "/c",
        "set PAYMENT_PROVIDER=manual&& npm run dev:api"
      ],
      "port": 4000
    },
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev:web"
      ],
      "port": 3000
    },
    {
      "name": "web-prod",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "serve:probe",
        "-w",
        "@basta/web"
      ],
      "port": 3100
    },
    {
      "name": "search",
      "runtimeExecutable": "C:/Users/Mirvat/OneDrive/Desktop/basta/.localdb/meili/meilisearch.exe",
      "runtimeArgs": [
        "--http-addr",
        "127.0.0.1:7701",
        "--db-path",
        ".localdb/meili/data",
        "--dump-dir",
        ".localdb/meili/dumps",
        "--master-key",
        "basta_local_dev_key_0001",
        "--env",
        "development"
      ],
      "port": 7701
    }
  ]
}
